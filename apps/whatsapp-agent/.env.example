APP_ENV=development
APP_NAME=LaundryKhalas WhatsApp Agent
AGENT_MODE=standalone

# --- Database mode / environment (DEV/TEST Supabase project) ---
# This backend can run against local SQLite (default) or the SEPARATE dev/test
# Supabase project. It is NEVER production. A production Supabase project is
# created later with its own config.
#   DATABASE_MODE=sqlite   -> local SQLite (default, safe placeholder here)
#   DATABASE_MODE=supabase -> dev/test Supabase Postgres (set DATABASE_URL below)
DATABASE_ENV=test
DATABASE_MODE=sqlite
SUPABASE_PROJECT_TYPE=test
# Seed/reset scripts refuse to run unless these are explicitly true (and the
# env is a confirmed dev/test project). Keep false by default.
ALLOW_TEST_SEED=false
ALLOW_TEST_RESET=false

# Supabase connection (dev/test project). Fill these in your local .env ONLY.
# DATABASE_URL is the backend-only Postgres connection string (session pooler
# or direct). SUPABASE_SERVICE_ROLE_KEY is BACKEND-ONLY — never expose it to the
# frontend. The dashboard talks to FastAPI, never to Supabase directly.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (Anthropic Claude) ------------------------------------------
# AI_PROVIDER selects the LLM: mock (default) = deterministic rule-based
# responder, zero cost, no network (local dev, CI, and the safe fallback);
# anthropic = real Claude. AI_PROVIDER falls back to the legacy LLM_PROVIDER if
# blank, so old .env files keep working. Nothing goes live until AI_PROVIDER is
# 'anthropic', ANTHROPIC_ENABLED=true, AND ANTHROPIC_API_KEY is present.
AI_PROVIDER=mock
LLM_PROVIDER=mock

# The API key is read ONLY here (backend), never logged, echoed, or sent to the
# frontend. Put the real key in the LOCAL/deployed .env (gitignored) — never here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Claude model id. Blank → claude-opus-4-8 (most capable). For this high-volume
# real-time WhatsApp path set claude-sonnet-5 or claude-haiku-4-5 to cut cost —
# a deliberate operator choice. Use exact ids, no date suffix. ANTHROPIC_MODEL
# falls back to LLM_MODEL if blank.
ANTHROPIC_MODEL=
LLM_MODEL=

# Anthropic tunables (validated at startup; safe defaults shown).
ANTHROPIC_ENABLED=true
ANTHROPIC_TOOL_USE_ENABLED=true
ANTHROPIC_LOG_USAGE=true
ANTHROPIC_STORE_RAW_CONTENT=false
ANTHROPIC_MAX_TOKENS=800
ANTHROPIC_TEMPERATURE=0.2
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_MAX_TOOL_ROUNDS=5
ANTHROPIC_HISTORY_MESSAGE_LIMIT=20
ANTHROPIC_HISTORY_CHARACTER_LIMIT=20000

# Let Claude ORCHESTRATE the booking via controlled write-tools (save_*/
# confirm_order) instead of the deterministic FSM. Default false = the proven
# deterministic booking flow stays live. Only takes effect when a live Claude
# provider is also configured. The backend validates + persists every write
# either way.
ANTHROPIC_BOOKING_ORCHESTRATION=false

# Humanized typing indicator. The chat UI holds an "agent is typing..." bubble
# for a natural delay before showing the reply (random between min and max).
# The backend does not block on these - it only publishes them via
# /api/settings/status; the delay is enforced in the frontend.
AGENT_MIN_TYPING_DELAY_MS=2000
AGENT_MAX_TYPING_DELAY_MS=3000

# ================= WhatsApp provider =================
# The dashboard NEVER talks to WhatsApp directly — it talks to FastAPI only, and
# FastAPI decides mock / evolution / meta from WHATSAPP_MODE below. Startup
# requires ONLY the active mode's vars; the other provider's vars stay blank
# placeholders and never block startup.
#
#   mock       -> no external WhatsApp provider (default; nothing required)
#   evolution  -> Evolution API  (CURRENT provider for testing)
#   meta       -> Meta WhatsApp Cloud API  (FUTURE provider)
WHATSAPP_MODE=mock

# --- CURRENT provider: Evolution API (required only when WHATSAPP_MODE=evolution) ---
# Point your Evolution instance's webhook (event: messages.upsert) at
#   {this backend}/webhooks/evolution
# so inbound WhatsApp messages land in the Supabase inbox. Outbound operator
# replies are sent via the inbox. EVOLUTION_AUTO_REPLY (default false) keeps the
# agent's happy-path draft held for human approval; escalations are always held.
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_AUTO_REPLY=false
# SAFETY allow-list: comma-separated E.164 numbers the agent may auto-reply to
# while testing. EVOLUTION_AUTO_REPLY=true ONLY takes effect for numbers listed
# here, and only for safe, laundry-related messages. Empty = auto-reply to no one
# (fail safe). Accepts JID / whatsapp: / +country / bare-digit forms.
#   EVOLUTION_ALLOWED_TEST_NUMBERS=+971500000000,+971500000001
EVOLUTION_ALLOWED_TEST_NUMBERS=

# --- FUTURE provider: Meta WhatsApp Cloud API (placeholders; required only when WHATSAPP_MODE=meta) ---
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# Local SQLite (DATABASE_MODE=sqlite). For DATABASE_MODE=supabase, replace this
# with the dev/test Supabase Postgres connection string.
#   Direct (IPv6-only): postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#   On IPv4 networks the direct host won't resolve — use the SESSION POOLER
#   (Dashboard -> Connect -> Session pooler), which is IPv4-friendly and works
#   with asyncpg on port 5432:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./whatsapp_agent.db

# NOTE: apps/admin (the main system's admin dashboard) already uses port
# 3000. This standalone agent's chat UI (apps/whatsapp-chat) runs on 3100
# instead so both can run side by side - see docs/architecture/
# standalone-whatsapp-agent.md for why. Update this if you change that port.
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000

# Demo/operational data classification
# ENABLE_DEMO_DATA=true only for local dev; staging/production=false excludes is_demo rows from order APIs.
ENABLE_DEMO_DATA=false
APP_ENV=development   # development | staging | production

# Agent operating mode: test | live | paused. SAFE DEFAULT = paused.
# test = reply only to EVOLUTION_ALLOWED_TEST_NUMBERS; live = all valid numbers; paused = store only.
WHATSAPP_AGENT_MODE=paused
DRAFT_EXPIRY_HOURS=24

# Dashboard auth / RBAC (spec §25). REQUIRE_AUTH=false (local dev) lets the
# dashboard in without a login as a synthetic admin. Set REQUIRE_AUTH=true for
# staging/production — then every guarded /api/* call needs a valid JWT and a
# real JWT_SECRET is mandatory (there is NO insecure fallback when auth is on).
# Requires DATABASE_MODE=supabase (users live in public.users). Bootstrap the
# first user with: python scripts/seed_admin_user.py --email ... --password ...
REQUIRE_AUTH=false
# Generate a strong secret, e.g. `openssl rand -hex 32`. Never commit the real one.
JWT_SECRET=
JWT_EXPIRY_HOURS=12
